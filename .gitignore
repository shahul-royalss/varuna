data/runs/*
!data/runs/.gitkeep

# Twin runs generated by `make train` to fit Flash-lite: 8 runs at ~24 MB each, and they are
# intermediate data rather than an artifact. The **fitted model** ships as demo/flash_lite.npz
# (~2 MB), which is what the API loads and what a deployment actually needs; regenerating the
# runs is one `make train` away.
data/train/
bundles/*/radar/
bundles/*/truth/
bundles/*/traffic/
*.zarr/
*.gpkg
*.tif
*.tiff

