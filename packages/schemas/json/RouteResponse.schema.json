{
  "$defs": {
    "AvoidedSegment": {
      "additionalProperties": false,
      "description": "A segment the naive route uses that VARUNA avoids, with why.",
      "properties": {
        "depth_p50_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth P50 Cm"
        },
        "name": {
          "description": "e.g. Hindmata junction",
          "title": "Name",
          "type": "string"
        },
        "p_exceed": {
          "description": "P(depth > threshold) at reached_ts.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Exceed",
          "type": "number"
        },
        "reached_ts": {
          "description": "When the naive route would have reached it (IST).",
          "format": "date-time",
          "title": "Reached Ts",
          "type": "string"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "threshold_cm": {
          "description": "Profile threshold applied.",
          "exclusiveMinimum": 0,
          "title": "Threshold Cm",
          "type": "integer"
        }
      },
      "required": [
        "segment_id",
        "name",
        "reached_ts",
        "threshold_cm",
        "p_exceed"
      ],
      "title": "AvoidedSegment",
      "type": "object"
    },
    "LineString": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              }
            ]
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "RouteResult": {
      "additionalProperties": false,
      "description": "One route with its forecast-aware summary.",
      "properties": {
        "arrival_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Ts"
        },
        "distance_km": {
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "eta_min": {
          "description": "Travel time in minutes under the forecast.",
          "minimum": 0,
          "title": "Eta Min",
          "type": "number"
        },
        "geometry": {
          "$ref": "#/$defs/LineString"
        },
        "label": {
          "default": "VARUNA",
          "enum": [
            "VARUNA",
            "Naive (shortest)",
            "Alternate"
          ],
          "title": "Label",
          "type": "string"
        },
        "max_expected_depth_cm": {
          "description": "Max p50 depth met along the route.",
          "minimum": 0,
          "title": "Max Expected Depth Cm",
          "type": "number"
        },
        "max_p_exceed": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest P(impassable) on any segment of the route.",
          "title": "Max P Exceed"
        },
        "safe_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest departure for which the route stays passable; None = horizon.",
          "title": "Safe Until"
        },
        "segment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "geometry",
        "eta_min",
        "distance_km",
        "max_expected_depth_cm"
      ],
      "title": "RouteResult",
      "type": "object"
    }
  },
  "$id": "urn:varuna:schema:RouteResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response of ``POST /v1/route`` (blueprint 9.3 shape, with the naive route for comparison).",
  "properties": {
    "alternates": {
      "items": {
        "$ref": "#/$defs/RouteResult"
      },
      "title": "Alternates",
      "type": "array"
    },
    "avoided": {
      "items": {
        "$ref": "#/$defs/AvoidedSegment"
      },
      "title": "Avoided",
      "type": "array"
    },
    "compute_ms": {
      "description": "Routing wall-clock (budget 300 ms).",
      "minimum": 0,
      "title": "Compute Ms",
      "type": "integer"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "confidence_note": {
      "description": "e.g. 'high (lead 30 min)'.",
      "title": "Confidence Note",
      "type": "string"
    },
    "depart_at": {
      "format": "date-time",
      "title": "Depart At",
      "type": "string"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Plain language, e.g. 'Avoids Hindmata (82 % above 45 cm at 18:10) via Bharatmata'.",
      "title": "Explanation"
    },
    "naive": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Shortest route ignoring the forecast."
    },
    "profile": {
      "enum": [
        "ambulance",
        "fire_tender",
        "bus",
        "car",
        "two_wheeler",
        "pedestrian"
      ],
      "title": "Profile",
      "type": "string"
    },
    "risk_tolerance": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Risk Tolerance",
      "type": "number"
    },
    "route": {
      "$ref": "#/$defs/RouteResult"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "valid_ts": {
      "description": "Cycle time of the run used (IST).",
      "format": "date-time",
      "title": "Valid Ts",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "valid_ts",
    "profile",
    "depart_at",
    "risk_tolerance",
    "route",
    "confidence",
    "confidence_note",
    "compute_ms"
  ],
  "title": "RouteResponse",
  "type": "object"
}
