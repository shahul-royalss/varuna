{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "command",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@varuna/command", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "uvicorn", "varuna_api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
