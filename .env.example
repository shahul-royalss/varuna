# ---- VARUNA runtime -------------------------------------------------------
VARUNA_CITY=mumbai
VARUNA_BUNDLE=MUM-2019-07-02
VARUNA_REPLAY_SPEED=30
# replay | live
VARUNA_MODE=replay
# 1 = block all outbound network (offline package / tests)
VARUNA_OFFLINE=0
# POST /v1/onboard (city-in-a-box). On for the demo laptop; the Railway image sets 0, because one
# public build filled the 500 MB volume and took the API down (2026-09-13).
VARUNA_ONBOARD_ENABLED=1
VARUNA_API_PORT=8000
VARUNA_UI_PORT=3000

# ---- Next.js ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1/live
# CARTO dark matter, no labels (free with attribution)
NEXT_PUBLIC_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-nolabels-gl-style/style.json

# ---- Optional providers (leave empty; fallbacks are built in) --------------
MAPPLS_KEY=
TOMTOM_KEY=
OPENTOPO_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
POSTGRES_URL=
REDIS_URL=

# ---- Tooling --------------------------------------------------------------
# uv on this machine needs the Windows certificate store for downloads
UV_SYSTEM_CERTS=1

# Public site URL, used to resolve Open Graph image URLs (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
